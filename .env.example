# Cloudflare Pages Functions environment variables (functions/).
# These are set in the Cloudflare Pages dashboard under
# Settings -> Environment variables (Production and Preview), not in this file
# and not anywhere in this repository. This file documents names only.

# HMAC signing secret for publisher/admin session tokens (functions/_lib/auth.js).
# Generate a long random string; rotate by setting a new value in Cloudflare
# (this invalidates all existing sessions).
SESSION_SECRET=replace-with-a-long-random-string

# Password required to access the admin approval UI (admin/publishers.html
# -> functions/api/admin-login.js). Store only a strong, unique value.
ADMIN_PASSWORD=replace-with-a-strong-password

# The PUBLISHERS_KV namespace binding (used by functions/api/publishers-*.js
# and admin-*.js) is configured in wrangler.toml by ID, not by an env var --
# no KV credential belongs in this file.
