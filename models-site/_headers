# Same baseline security headers as the main photoczaro.com site.
# CSP is intentionally stricter here: this site has no third-party analytics/
# ad scripts wired in yet, so no external allowances are pre-added beyond
# what's needed. Extend this only when a specific integration (Turnstile,
# etc.) needs it.
#
# Enforced (not Report-Only). static.cloudflareinsights.com/
# cloudflareinsights.com are Cloudflare's own zone-level Web Analytics
# beacon, auto-injected at the edge (not something in this repo's HTML),
# discovered only after enforcing turned up a real console violation on
# first production check - allowlisted rather than left broken.
# 'unsafe-inline' stays for now on both script-src and style-src: removing
# it needs nonces/hashes added to every inline <script> and style=""
# attribute across ~10 pages plus the admin panel, which is a real refactor,
# not a quick toggle - do that as deliberate follow-up work.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'

/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/admin/*
  Cache-Control: no-store
/api/admin/*
  Cache-Control: no-store

# Never index the admin panel, the API, or the *.pages.dev preview hosts
# (the custom domain is the canonical site).
/admin/*
  X-Robots-Tag: noindex, nofollow
/api/*
  X-Robots-Tag: noindex, nofollow
https://:project.pages.dev/*
  X-Robots-Tag: noindex
