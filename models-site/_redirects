# Clean model-profile URLs: /models/:slug rewrites (200, URL stays) to the
# templated model.html, which reads the slug from the path (see model.html's
# inline script). /model?slug=... keeps working for old shared links.
/models/:slug /model?slug=:slug 200

# Redirect .html to extensionless for canonical URLs (matches the main site's convention).
/index.html / 301
/models.html /models 301
/model.html /model 301
/book-talent.html /book-talent 301
/apply.html /apply 301
/about.html /about 301
/contact.html /contact 301
/booking-terms.html /booking-terms 301
/privacy-policy.html /privacy-policy 301
